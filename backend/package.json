{
    "name": "nijichat-backend",
    "version": "1.0.0",
    "description": "NijiChat 后端 - 基于Golang的Cloudflare Workers服务",
    "private": true,
    "scripts": {
        "build:local": "go run github.com/syumai/workers/cmd/workers-assets-gen -mode=go && GOOS=js GOARCH=wasm go build -o ./build/app.wasm .",
        "build:deploy": "go run github.com/syumai/workers/cmd/workers-assets-gen && tinygo build -o ./build/app.wasm -target wasm -no-debug ./...",
        "dev": "wrangler dev",
        "start": "wrangler dev",
        "deploy": "wrangler deploy --env production",
        "deploy:staging": "wrangler deploy --env staging"
    },
    "keywords": [
        "golang",
        "cloudflare-workers",
        "ai-chat",
        "seiyuu",
        "backend"
    ],
    "author": "xiaoti",
    "devDependencies": {
        "wrangler": "^4.44.0"
    }
}