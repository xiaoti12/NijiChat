{
  // Cloudflare Workers 配置文件
  // 使用 JSONC 格式支持注释
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seiyuu-chat-backend",
  "main": "./build/worker.mjs",
  "compatibility_date": "2025-11-06",
  // D1 数据库绑定
  "d1_databases": [
    {
      "binding": "SEIYUU_DB",
      "database_name": "seiyuu-chat-db",
      "database_id": "your-d1-database-id",
      "preview_database_id": "4d581c6d-f7e3-47ee-a8ff-1b0d2f744c8b"
    }
  ],
  // KV 命名空间绑定
  "kv_namespaces": [
    {
      "binding": "SEIYUU_KV",
      "id": "your-kv-namespace-id",
      "preview_id": "ec390fc715c24f1b9b21b4cf41940546"
    }
  ],
  // 环境变量配置
  "vars": {
    "ENVIRONMENT": "development",
    "MOEGIRL_API_BASE_URL": "https://zh.moegirl.org.cn/api.php"
  },
  // 生产环境配置
  "env": {
    "production": {
      "name": "seiyuu-chat-backend-production",
      "vars": {
        "ENVIRONMENT": "production",
        "MOEGIRL_API_BASE_URL": "https://zh.moegirl.org.cn/api.php"
      },
      // 生产环境的敏感变量通过 wrangler secret put 设置
      // wrangler secret put ADMIN_JWT_SECRET --env production
      // wrangler secret put ADMIN_USERNAME --env production (可选)
      // wrangler secret put ADMIN_PASSWORD --env production (可选)
      "build": {
        "command": "npm run build:deploy"
      },
      "d1_databases": [
        {
          "binding": "SEIYUU_DB",
          "database_name": "seiyuu-chat-db-production",
          "database_id": "your-production-d1-database-id"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SEIYUU_KV",
          "id": "your-production-kv-namespace-id"
        }
      ]
    },
    "staging": {
      "name": "seiyuu-chat-backend-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "MOEGIRL_API_BASE_URL": "https://zh.moegirl.org.cn/api.php"
      },
      "build": {
        "command": "npm run build:deploy"
      },
      "d1_databases": [
        {
          "binding": "SEIYUU_DB",
          "database_name": "seiyuu-chat-db-prev",
          "database_id": "4d581c6d-f7e3-47ee-a8ff-1b0d2f744c8b"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SEIYUU_KV",
          "id": "ec390fc715c24f1b9b21b4cf41940546"
        }
      ]
    }
  },
  // 构建配置（用于本地开发 wrangler dev）
  "build": {
    "command": "npm run build:local"
  },
  // 观察者配置（开发模式）
  "observability": {
    "enabled": true
  },
  // 日志配置
  "logpush": false,
  // 尾部消费者（用于实时日志）
  "tail_consumers": []
}