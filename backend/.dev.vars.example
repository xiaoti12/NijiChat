# 开发环境变量示例文件
# 复制此文件为 .dev.vars 并填入实际值
# .dev.vars 文件会被 .gitignore 忽略，不会提交到 git

# ========== 管理员认证配置 ==========

# 管理员 JWT 密钥（开发环境）
ADMIN_JWT_SECRET=dev-jwt-secret-key-please-change-in-production

# 管理员账号配置（硬编码方式）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin456

# 萌娘百科 API 地址
MOEGIRL_API_BASE_URL=https://zh.moegirl.org.cn/api.php

# 开发环境标识
ENVIRONMENT=development

# 日志级别（debug, info, warn, error）
LOG_LEVEL=debug

# CORS 允许的来源（开发环境）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 测试码功能 - API Key
# 用于测试码功能返回的AI模型配置
TEST_MODEL_API_KEY=sk-your-test-api-key-here
